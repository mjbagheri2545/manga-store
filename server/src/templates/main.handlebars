<html lang="fa">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      a { text-decoration: none; color: #c026d3;} ul { list-style: none;
      padding: 0 }

    </style>
  </head>
  <body style="direction: rtl; font-size: 18px;">
    <div style="color: #121212;max-width: 600px;margin: 0 auto;">
      <header
        style="background-color: #c026d3; padding: 0.75rem 0;border-radius: 0.5rem 0.5rem 0 0; color:#fff"
      >
        <div style="text-align: center;">
          <h1 style="font-size: 1.5rem;margin-bottom: 0.25rem">
            <a
              style="color: #4ec7ff;text-decoration:underline;margin: 0 0.5rem;padding: 0 0.25rem;"
              href="http://localhost:5173"
            >{{appName}}</a>,پلی میان فرهنگ‌ها، با ترجمه‌ای روان از دنیای مانگا
            !</h1>
        </div>
        <p style="text-align: center;margin-top:0;color: #fff;">دنیای مانگا را
          به زبان شما نزدیک‌تر می‌کنیم!</p>
      </header>
      <div>
        {{{content}}}
      </div>
      <footer
        style="margin-top: 1.5rem;background-color:#f4f4f4; border-radius: 0 0 0.5rem 0.5rem; padding: 1.25rem 0;"
      >
        <p style="text-align: center;margin: 0">Copyright &copy; 2024
          {{appName}}, All rights reserved.</p>
      </footer>
    </div>
  </body>
</html>