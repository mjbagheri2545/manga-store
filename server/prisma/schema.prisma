// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid()) @db.Char(36)
  fullName           String    @db.VarChar(65)
  email              String    @unique @db.VarChar(65)
  password           String    @db.Char(60)
  oldPasswords       String[]  @default([]) @db.Char(60)
  avatarImage        String?   @db.VarChar(255)
  createdAt          DateTime  @default(now())
  roles              Role[]    @default([user])
  isVerified         Boolean   @default(false)
  emailRemainingTime DateTime?

  Token              Token?
  averageRatings     ProductAverageRating[]
  translatedChapters Chapter[]
  managedProducts    Product[]
}

enum Role {
  user
  translator
  manager
  admin
}

model Token {
  id               String   @id @default(uuid()) @db.Char(36)
  verificationCode String   @db.Char(6)
  expirationTime   DateTime
  userId           String   @unique @db.Char(36)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id           String   @id @default(uuid()) @db.Char(36)
  name         String   @db.VarChar(100)
  persianName  String   @db.VarChar(100)
  designer     String   @db.VarChar(65)
  writer       String   @db.VarChar(65)
  releaseYear  Int      @db.SmallInt
  summary      String   @db.Text
  priceInRials Int      @db.SmallInt
  productImage String   @db.VarChar(255)
  slug         String   @unique @db.VarChar(255)
  createdAt    DateTime @default(now())

  averageRating ProductAverageRating?

  manager   User?   @relation(fields: [managerId], references: [id], onDelete: SetDefault)
  managerId String? @default("مدیر حذف شده") @db.Char(36)

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String   @db.Char(36)

  status   ProductStatus @relation(fields: [statusId], references: [id], onDelete: SetDefault)
  statusId String        @default("پایان یافته") @db.Char(36)

  chapters Chapter[]
  tags     Tag[]

  @@index([categoryId])
  @@index([managerId])
}

model ProductAverageRating {
  rating Decimal @default(0) @db.Decimal(2, 1)

  product   Product @relation(fields: [productId], references: [id])
  productId String  @unique @db.Char(36)

  ratedBy   User   @relation(fields: [ratedById], references: [id])
  ratedById String @unique @db.Char(36)

  @@id([productId, ratedById])
}

model Chapter {
  id          String @id @default(uuid()) @db.Char(36)
  episode     Int    @db.SmallInt
  chapterFile String @db.VarChar(255)

  translator   User?   @relation(fields: [translatorId], references: [id], onDelete: SetDefault)
  translatorId String? @default("مترجم حذف شده") @db.Char(36)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String  @db.Char(36)
}

model ProductStatus {
  id       String    @id @default(uuid()) @db.Char(36)
  name     String    @unique @db.VarChar(50)
  slug     String    @unique @db.VarChar(50)
  products Product[]
}

model Category {
  id       String    @id @default(uuid()) @db.Char(36)
  name     String    @unique @db.VarChar(50)
  slug     String    @unique @db.VarChar(50)
  products Product[]
}

model Tag {
  id       String    @id @default(uuid()) @db.Char(36)
  name     String    @unique @db.VarChar(50)
  slug     String    @unique @db.VarChar(50)
  products Product[]
}
